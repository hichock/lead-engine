# Lead Engine environment. Copy to .env.local for local runs (never commit it).
# /lead-engine:setup fills .env.local and pushes the same values to Vercel. No values belong in this file.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: cron and agent routes use it. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used by scripts/le.mjs sql (optional, local only): project ref + a personal access token from supabase.com/dashboard/account/tokens
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- App ---
# Public URL of the deployed app, e.g. https://lead-engine-yourname.vercel.app (magic-link redirects)
NEXT_PUBLIC_SITE_URL=
# Random secrets: openssl rand -hex 32
CRON_SECRET=
AGENT_TOKEN=
# 32 random bytes, base64: openssl rand -base64 32. Encrypts mailbox app passwords.
MAILBOX_ENCRYPTION_KEY=
# Set to 1 to show example data without Supabase (local demo, screenshots)
DEMO=

# --- Sources (each optional; a source without its key refuses calls with a clear error) ---
# urlscan.io free key: 1,000 searches a day, public scans of the last 30 days
URLSCAN_API_KEY=
# Google Cloud service-account JSON (raw or base64) with BigQuery Job User; used for HTTP Archive
GCP_SA_KEY=
# Apify API token (actors run with a hard spend ceiling)
APIFY_TOKEN=
# Monid key (pay per call: Hunter, ContactOut and more)
MONID_API_KEY=
# MillionVerifier API key
MILLIONVERIFIER_API_KEY=
# Apollo API key (only the free people search is used)
APOLLO_API_KEY=
# HackerTarget key for reverse IP (optional)
HACKERTARGET_API_KEY=

# --- Used by scripts/le.mjs (Claude skills, local or cloud sessions) ---
# The deployed app URL and the same AGENT_TOKEN as above
LEAD_ENGINE_URL=

# --- Local mode (no Supabase, no Vercel): set LEAD_ENGINE_MODE=local and skip the Supabase/App blocks above ---
# scripts/le.mjs then runs every command on this machine (scripts/local.ts) with the same caps, ledger and checks.
LEAD_ENGINE_MODE=
# Store: a SQLite file (default data/lead-engine.db, gitignored) or your own Postgres: postgres://user:pass@host:5432/db
# (run `npm i pg` once for Postgres)
LEAD_ENGINE_DB=
# Mailboxes for `le send` / `le replies` (local mode only; in app mode add them in Settings → Mailboxes):
# MAILBOX_1=you@send-domain.com|Your Name|smtp.gmail.com:465|imap.gmail.com:993|15
# MAILBOX_1_PASSWORD=<app password>
